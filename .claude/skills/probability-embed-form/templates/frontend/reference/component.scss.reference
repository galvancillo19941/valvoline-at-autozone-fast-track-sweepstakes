// Valvoline brand tokens. Hardcoded here (not in ../../styles/_tokens.scss)
// because that partial holds the boilerplate's generic neutral palette —
// this embed needs Valvoline's own colors and typefaces.
$valvoline-blue: #00316d;
$color-white: #ffffff;
$color-gray-dark: #616161;
$color-gray: #8a8c8e;
$color-error: #f4e400;

$font-body: "Barlow", sans-serif;
$font-heading: "Barlow Condensed", sans-serif;

.probability-valvoline-oil-change-us {
  display: grid !important;
  align-items: center !important;
  justify-content: center !important;
  width: 100% !important;
  min-height: 100vh !important;
  margin: 0 !important;
  padding: 0 !important;
  font-family: $font-body !important;
  box-sizing: border-box !important;

  position: relative !important;

  // Kept in the layout (so FilePond can measure itself) but invisible until
  // #enhanceForm has styled it; the spinner shows meanwhile.
  &__form--loading {
    position: absolute !important;
    left: 0 !important;
    right: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  &__loader {
    align-items: center !important;
    justify-content: center !important;
    min-height: 40vh !important;
  }

  &__spinner {
    width: 48px !important;
    height: 48px !important;
    padding: 8px !important;
    border-radius: 50% !important;
    background: $valvoline-blue !important;
    --_m: conic-gradient(#0000 10%, #000), linear-gradient(#000 0 0) content-box !important;
    -webkit-mask: var(--_m) !important;
    mask: var(--_m) !important;
    -webkit-mask-composite: source-out !important;
    mask-composite: subtract !important;
    animation: probability-valvoline-oil-change-us-spin 1s infinite linear !important;
  }

  // The remote <universal-form> is themed only through its --uf-* custom
  // properties; values ported from the previous (Universal Form webcomponent)
  // stylesheet.
  universal-form {
    display: block !important;
    width: 100% !important;
    max-width: 820px !important;
    margin: 0 auto !important;
    padding: 1.5rem 0 !important;
    box-sizing: border-box !important;

    @media (min-width: 768px) {
      padding: 2.5rem 2rem !important;
    }

    --uf-font-family: #{$font-body} !important;
    --uf-font-size: 16px !important;
    --uf-color: #{$color-white} !important;
    --uf-label-color: #{$color-white} !important;
    --uf-hint-color: #{$color-white} !important;
    --uf-required-color: #{$color-white} !important;
    --uf-primary: #{$valvoline-blue} !important;

    --uf-input-bg: #{$color-white} !important;
    --uf-input-color: #{$color-gray-dark} !important;
    --uf-input-border: #{$color-gray-dark} !important;
    --uf-input-radius: 4px !important;
    --uf-placeholder-color: #{$color-gray-dark} !important;
    --uf-option-color: #{$color-gray-dark} !important;
    --uf-option-selected-bg: #{$valvoline-blue} !important;
    --uf-option-selected-color: #{$color-white} !important;
    --uf-option-hover-bg: #{$valvoline-blue} !important;
    --uf-dropdown-bg: #{$color-white} !important;
    --uf-dropdown-border: #{$color-gray} !important;
    --uf-focus-color: #{$valvoline-blue} !important;
    --uf-focus-ring: transparent !important;

    --uf-error-color: #{$color-error} !important;
    --uf-error-border: #{$color-error} !important;
    --uf-error-ring: #{rgba($color-error, 0.5)} !important;
    --uf-error-size: 13px !important;

    --uf-checkbox-accent: #{$valvoline-blue} !important;
    --uf-checkbox-desc-color: #{$color-white} !important;

    --uf-upload-bg: #{$color-white} !important;
    --uf-upload-border: #{$valvoline-blue} !important;
    --uf-upload-active-border: #{$valvoline-blue} !important;
    --uf-upload-label-color: #{$valvoline-blue} !important;
    --uf-upload-hint-color: #{$color-gray-dark} !important;
    --uf-upload-icon-color: #{$valvoline-blue} !important;
    --uf-upload-browse-color: #{$valvoline-blue} !important;
    --uf-upload-add-bg: #ecf2f3 !important;
    --uf-upload-add-border: #ecf2f3 !important;
    --uf-upload-alert-color: #{$color-error} !important;
    --uf-upload-failed-color: #{$color-error} !important;

    --uf-fields-gap: 11px !important;
    --uf-grid-gap: 20px !important;

    --uf-btn-bg: #{$valvoline-blue} !important;
    --uf-btn-color: #{$color-white} !important;
    --uf-btn-hover-bg: #001f44 !important;
    --uf-btn-radius: 0 !important;
    --uf-btn-size: 18px !important;
    --uf-btn-width: 100% !important;
    --uf-submit-width: 100% !important;
  }

  // Field errors (required, upload) sit under the field, pushed to the right,
  // without the form's own leading dot.
  universal-form .field-required-error {
    justify-content: flex-end !important;
    text-align: right !important;

    &::before {
      display: none !important;
    }
  }

  // The error is a <p> in the light DOM, so a host page that styles every `p`
  // beats the component's own var(--uf-error-*) values. valvolineglobal.com
  // forces white (3 classes deep) and, via `.rich-text__body p`, 1.225rem /
  // line-height 1.5, all !important. The repeated class raises specificity
  // above those without naming the host's selectors.
  &#{&}#{&} universal-form p.field-required-error {
    color: $color-error !important;
    font-family: $font-body !important;
    font-size: 13px !important;
    font-weight: 400 !important;
    line-height: 1.4 !important;
  }

  universal-form .required-legend,
  universal-form .uf-image-upload-label {
    display: none !important;
  }

  // "General Info" / "Upload Store Receipt" — inserted by #enhanceForm.
  &__section-heading {
    display: flex !important;
    align-items: center !important;
    gap: 25px !important;
    margin: 5px 0 !important;
  }

  &__section-text {
    font-family: $font-heading !important;
    font-size: 18px !important;
    font-weight: 700 !important;
    color: $color-white !important;
    text-transform: uppercase !important;
    letter-spacing: 0.5px !important;
    white-space: nowrap !important;
  }

  &__section-line {
    flex: 1 !important;
    height: 1px !important;
    background: rgba(255, 255, 255, 0.5) !important;
  }

  // Dropzone (FilePond, light DOM): dashed blue box with the folder icon and
  // the two lines of copy the previous form had. FilePond's own label markup
  // is hidden and replaced through pseudo-elements.
  universal-form {
    // White card around the dropzone only. It used to be the whole field
    // wrapper, which also holds the "Please upload a receipt" error, so the
    // error ended up inside the card (yellow on white). On the element itself
    // the error is a sibling: outside the card, below it, on the red page.
    uf-image-upload {
      display: block !important;
      background: $color-white !important;
      border-radius: 6px !important;
      padding: 16px !important;
      box-sizing: border-box !important;

      @media (max-width: 480px) {
        padding: 10px !important;
      }
    }

    .field-wrapper:has(uf-image-upload) .field-required-error {
      margin-top: 6px !important;
    }

    // Breathing room between the tips band, the opt-in and the submit button.
    .field-wrapper:has(uf-checkbox) {
      padding: 16px 0 !important;
    }

    // Stacked checkboxes (opt-in, then the legal one): the wrappers are direct
    // children of .fields, each with 16px of padding plus the form's 16px gap.
    // The second drops its top padding and pulls up over the gap.
    .field-wrapper:has(uf-checkbox) + .field-wrapper:has(uf-checkbox) {
      margin-top: -12px;
      padding-top: 0 !important;
    }

    // A checkbox that fails validation (the required legal one) has no message
    // under it: its whole text turns yellow, links included, and goes back to
    // white once it is checked (the form drops the error then).
    .field-wrapper:has(uf-checkbox):has(.field-required-error) {
      uf-checkbox {
        --uf-checkbox-label-color: #{$color-error} !important;
        --uf-checkbox-link-color: #{$color-error} !important;
      }

      .field-required-error {
        display: none !important;
      }
    }

    .filepond--root {
      font-family: $font-body !important;
      margin-bottom: 0 !important;
    }

    // FilePond stretches the picked file's card with `left: 0; right: 0` and no
    // width of its own, so a host page rule on `ul`/`li` (width, max-width,
    // float, a different `right`) shrinks it to part of the box. Pin it to the
    // full width.
    .filepond--list-scroller,
    .filepond--list,
    .filepond--item {
      position: absolute !important;
      left: 0 !important;
      right: 0 !important;
      width: auto !important;
      min-width: 0 !important;
      max-width: none !important;
      float: none !important;
      margin-left: 0 !important;
      margin-right: 0 !important;
    }

    .filepond--panel-root {
      background: $color-white !important;
      border: 2px dashed $valvoline-blue !important;
      border-radius: 4px !important;
    }

    // The form draws its own bordered, rounded layers on top; only the
    // panel root should carry the dashed border.
    .filepond--panel-top,
    .filepond--panel-center,
    .filepond--panel-bottom {
      background: transparent !important;
      border: 0 !important;
    }

    .filepond--drop-label {
      color: $valvoline-blue !important;
      min-height: 180px !important;
    }

    .filepond--drop-label label {
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
      height: 100% !important;
      box-sizing: border-box !important;
      padding: 58px 20px 20px !important;
      text-align: center !important;
      cursor: pointer !important;
      // Hides FilePond's own bare text node ("Drag your image or"); the
      // pseudo-elements below set their own sizes.
      font-size: 0 !important;
      background: url("./folder-arrow-up.svg") center 22px / 36px no-repeat !important;

      > * {
        display: none !important;
      }

      &::before {
        content: "CLICK TO UPLOAD RECEIPT" !important;
        font-family: $font-heading !important;
        font-size: 24px !important;
        font-weight: 700 !important;
        color: $valvoline-blue !important;
        margin-bottom: 6px !important;
      }

      &::after {
        content: "Click to upload or drag and drop JPG, JPEG, PNG, PDF, HEIC & HEIF (Max 30MB)" !important;
        font-size: 15px !important;
        font-weight: 600 !important;
        letter-spacing: 0.3px !important;
        color: $color-gray-dark !important;
      }

      // The box is a fixed 180px, so on a narrow screen the hint wraps to 3-4
      // lines and its last one ("(Max 30MB)") ran out through the dashed
      // border. Smaller type and padding keep four lines inside it at 320px.
      @media (max-width: 480px) {
        padding: 46px 12px 14px !important;
        background-position: center 14px !important;

        &::before {
          font-size: 22px !important;
          margin-bottom: 4px !important;
        }

        &::after {
          font-size: 13px !important;
          line-height: 1.3 !important;
          letter-spacing: 0 !important;
        }
      }
    }

    // A PDF is a file FilePond cannot draw, so its box used to stay blank (the
    // name and size were there, white on white). The component flags the field
    // with data-file-kind="pdf" while it holds one; show the "upload complete"
    // artwork across the whole box. The box keeps its own height (FilePond
    // writes the root's height inline and does not re-read it once the PDF is
    // removed, so resizing it for the image left the idle dropzone taller);
    // `cover` crops the artwork's edges instead.
    // The remove button stays; the file name sits on the artwork's text, so it
    // is hidden (the field is announced through the button's label).
    uf-image-upload[data-file-kind="pdf"] {
      // .filepond--panel.filepond--panel-root, not just .filepond--panel-root:
      // the panel's top/center/bottom strips carry that class too, and each one
      // would repaint the image, leaving seams between them.
      .filepond--panel.filepond--panel-root {
        background: $color-white url("./pdf-preview.png") center / cover no-repeat !important;
        border: 0 !important;
      }

      .filepond--item-panel,
      .filepond--file-info,
      .filepond--file-status {
        display: none !important;
      }
    }
  }

  &__tips {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 12px !important;
    flex-wrap: wrap !important;
    background: #eff1f4 !important;
    border-radius: 8px !important;
    padding: 14px 16px !important;
    // The fields container already adds ~11px of gap above this.
    margin-top: 9px !important;

    .probability-valvoline-oil-change-us__tips-text {
      margin: 0 !important;
      color: $color-gray !important;
      font-size: 14px !important;
    }

    .probability-valvoline-oil-change-us__tips-link {
      color: $valvoline-blue !important;
      font-weight: 700 !important;
      font-size: 14px !important;
      text-transform: uppercase !important;
      text-decoration: underline !important;

      &:hover {
        color: #001f44 !important;
      }
    }
  }

  // Cloudflare Turnstile, mounted by #enhanceTurnstile above the submit button.
  // The widget draws its own iframe; only its box and our message are styled.
  &__turnstile {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    gap: 6px !important;
    margin: 16px 0 0 !important;
    min-height: 65px !important;
  }

  &__turnstile-message {
    margin: 0 !important;
    text-align: center !important;
    color: $color-error !important;
    font-family: $font-body !important;
    font-size: 13px !important;
    line-height: 1.4 !important;

    &[hidden] {
      display: none !important;
    }
  }

  // "Not started yet" / "promotion is over" — the form's own banner, shown in
  // place of the fields outside the campaign window.
  universal-form .state-banner {
    align-items: center !important;
    padding: 1.5rem 1rem !important;
    border: 0 !important;
    background: transparent !important;
    text-align: center !important;
  }

  universal-form .state-banner-title {
    color: $color-white !important;
    font-family: $font-heading !important;
    font-weight: 700 !important;
    font-size: 32px !important;
    line-height: 1.1 !important;
    text-transform: uppercase !important;

    @media (min-width: 768px) {
      font-size: 44px !important;
    }
  }

  universal-form .state-banner-description {
    color: $color-white !important;
    font-family: $font-heading !important;
    font-weight: 700 !important;
    font-size: 17px !important;
    letter-spacing: normal !important;
    text-transform: uppercase !important;

    @media (min-width: 768px) {
      font-size: 24px !important;
    }
  }

  &__upload-error {
    margin: 6px 0 0 !important;
    text-align: right !important;
    color: $color-error !important;
    font-family: $font-body !important;
    font-size: 13px !important;
    line-height: 1.4 !important;
  }

  .thank-you {
    max-width: 640px !important;
    margin: 0 auto !important;
    padding: 1.5rem 1rem !important;
    text-align: center !important;

    h2 {
      color: $color-white !important;
      font-family: $font-heading !important;
      font-weight: 700 !important;
      font-size: 32px !important;

      @media (min-width: 768px) {
        font-size: 44px !important;
      }
    }

    p {
      color: $color-white !important;
      font-family: $font-heading !important;
      font-weight: 700 !important;
      font-size: 17px !important;
      letter-spacing: normal !important;
      margin: 0 0 0.5rem !important;

      @media (min-width: 768px) {
        font-size: 18px !important;
      }
    }
  }

  input:-webkit-autofill,
  input:-webkit-autofill:hover,
  input:-webkit-autofill:focus {
    -webkit-box-shadow: 0 0 0 30px $color-white inset !important;
    -webkit-text-fill-color: $color-gray-dark !important;
  }
}

@keyframes probability-valvoline-oil-change-us-spin {
  to {
    transform: rotate(1turn);
  }
}
