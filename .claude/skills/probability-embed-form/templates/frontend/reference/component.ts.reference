  ["https://fonts.googleapis.com", false],
  ["https://fonts.gstatic.com", true],
];
const FONT_URLS = [
  "https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap",
  "https://fonts.googleapis.com/css2?family=Passion+One:wght@400;700;900&display=swap",
  "https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&display=swap",
];

// <universal-form> is defined by this remote ES module. Only our own demo pages
// carry it in their HTML, so the embed loads it itself for a consumer page.
const UNIVERSAL_FORM_SRC = "https://universal-form.onprobability.com/v1/dist/index.js";
const API_BASE = "https://api.helloprobability.io";
// Cloudflare Turnstile. The new <universal-form> has no captcha support at all
// (the old webcomponent drew it itself), so it is loaded and rendered here.
// `render=explicit` because the widget is mounted by hand, once the form has
// built the spot for it.
const TURNSTILE_SCRIPT_URL = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
// How long to wait for the script before telling the visitor it did not load.
const TURNSTILE_LOAD_TIMEOUT_MS = 15_000;
// Cloudflare's always-passes test key: the program's real key is bound to its
// production hostnames, so on localhost it would just error out.
const TURNSTILE_TEST_SITE_KEY = "1x00000000000000000000AA";
const IS_LOCALHOST = ["localhost", "127.0.0.1", "[::1]"].includes(window.location.hostname);

interface TurnstileApi {
  render(
    container: HTMLElement,
    options: {
      sitekey: string;
      theme?: "light" | "dark" | "auto";
      callback: (token: string) => void;
      "expired-callback": () => void;
      "error-callback": () => void;
    },
  ): string;
  remove(widgetId: string): void;
}

declare global {
  interface Window {
    turnstile?: TurnstileApi;
  }
}

// Turnstile is on when the program says so in its settings; the token goes out
// under the program's own hidden field (grecaptcha_validation, named by the
// old form after reCAPTCHA but used for Turnstile too).
interface CaptchaSettings {
  siteKey: string;
  fieldName: string;
}
