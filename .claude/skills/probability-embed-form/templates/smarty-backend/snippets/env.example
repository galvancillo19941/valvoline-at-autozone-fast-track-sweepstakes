# Copy to .env for local dev (gitignored). Production sets these in the host's
# environment panel. server/index.ts calls process.loadEnvFile(), which strips
# surrounding quotes — hosting panels do NOT. Never paste a quoted value there.

# --- Smarty address autocomplete (server/services/smarty-streets.ts) ---
# The secret pair. Without one of these the /api/address/* routes answer 500.
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=
# Browser "embedded key" alternative, authorized per-domain in Smarty's dashboard.
SMARTY_WEBSITE_KEY=
# Optional — defaults to {{SERVER_HOST}}.
SMARTY_WEBSITE_HOST=

# --- Server ---
# Optional — defaults to 3000.
PORT=
